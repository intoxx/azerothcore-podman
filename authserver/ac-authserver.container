[Unit]
Description=Authserver used within AzerothCore
After=ac-database.container
Requires=ac-database.container

[Container]
Pod=ac.pod
Image=localhost/ac/authserver
PodmanArgs=--tty
Volume=./azerothcore-wotlk:/azerothcore-wotlk:ro,Z
Volume=./config/etc:/ac/etc:Z

Environment=AC_SOURCE_DIRECTORY=/azerothcore-wotlk

[Install]
WantedBy=default.target
